# The service layer (src/serve/api.py), as its own small image.
#
# Separate from the vLLM image on purpose. That one is 12 GB and rebuilds
# slowly; this one is ~200 MB and rebuilds in a couple of minutes, which
# matters because the gateway is the half that actually changes. They also
# scale differently: the gateway is CPU-only and could run many replicas,
# while the vLLM pod is pinned to the single L4.
FROM python:3.12-slim

WORKDIR /app

# Pinned to the same floors pyproject.toml declares. No torch, no vllm --
# this process never touches a model, it only speaks HTTP to one.
RUN pip install --no-cache-dir \
      "fastapi>=0.120.0" \
      "uvicorn>=0.38.0" \
      "openai>=3.3.1" \
      "prometheus-client>=0.21.0" \
      "pyyaml>=6.0.3" \
      "httpx>=0.28.0"

# Only the modules api.py actually imports. src/finetune and src/eval are
# left out deliberately: they pull torch/transformers, which would take the
# image from megabytes to gigabytes for code this process never runs.
COPY config/ /app/config/
COPY src/__init__.py /app/src/
COPY src/config.py /app/src/
COPY src/serve/ /app/src/serve/

EXPOSE 8080
# SERANA_BASE_URL is set by the manifest to the vLLM Service's DNS name;
# without it src/serve/pipeline.py falls back to base.yaml's localhost,
# which is correct on a laptop behind port-forward and wrong in a pod.
CMD ["uvicorn", "src.serve.api:app", "--host", "0.0.0.0", "--port", "8080"]
